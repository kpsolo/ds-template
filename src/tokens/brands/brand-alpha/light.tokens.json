{
  "semantic": {
    "color": {
      "$type": "color",
      "surface": {
        "canvas": {
          "$value": "{primitive.color.slate.50}",
          "$description": "Page background"
        },
        "default": {
          "$value": "{primitive.color.white}",
          "$description": "Default card / container surface"
        },
        "subtle": {
          "$value": "{primitive.color.slate.100}",
          "$description": "Subtle surface for zebra striping"
        },
        "raised": {
          "$value": "{primitive.color.white}",
          "$description": "Raised card surface"
        },
        "overlay": {
          "$value": "color-mix(in oklch, {primitive.color.slate.900} 45%, transparent)",
          "$description": "Modal backdrop with perceptual OKLCH alpha mixing"
        },
        "sunken": {
          "$value": "{primitive.color.slate.200}",
          "$description": "Sunken wells and code blocks"
        },
        "tint": {
          "$value": "color-mix(in oklch, {primitive.color.blue.600} 10%, {primitive.color.white})",
          "$description": "Brand-tinted highlight surface"
        }
      },
      "text": {
        "primary": {
          "$value": "{primitive.color.slate.900}",
          "$description": "Primary readable text (19.3:1 AAA)"
        },
        "secondary": {
          "$value": "{primitive.color.slate.600}",
          "$description": "Secondary / subtitle text (7.58:1 AAA)"
        },
        "tertiary": {
          "$value": "{primitive.color.slate.500}",
          "$description": "Muted metadata and captions (4.76:1 AA)"
        },
        "muted": {
          "$value": "{primitive.color.slate.600}",
          "$description": "High-contrast muted helper text (7.58:1 AAA)"
        },
        "placeholder": {
          "$value": "{primitive.color.slate.500}",
          "$description": "Accessible form input placeholder text (4.76:1 AA)"
        },
        "disabled": {
          "$value": "{primitive.color.slate.300}",
          "$description": "Disabled text (exempt under WCAG 1.4.3)"
        },
        "inverse": {
          "$value": "{primitive.color.white}",
          "$description": "Inverse text for dark backgrounds"
        },
        "brand": {
          "$value": "{primitive.color.blue.600}",
          "$description": "Text with brand color (5.17:1 AA)"
        },
        "link": {
          "$value": "{primitive.color.blue.600}",
          "$description": "Hyperlink default (5.17:1 AA)"
        },
        "linkHover": {
          "$value": "{primitive.color.blue.700}",
          "$description": "Hyperlink hover (6.7:1 AA)"
        }
      },
      "border": {
        "default": {
          "$value": "{primitive.color.slate.200}",
          "$description": "Default border for containers"
        },
        "subtle": {
          "$value": "{primitive.color.slate.100}",
          "$description": "Faint dividers"
        },
        "strong": {
          "$value": "{primitive.color.slate.400}",
          "$description": "Emphasized borders"
        },
        "focus": {
          "$value": "{primitive.color.blue.600}",
          "$description": "Focus ring indicator"
        },
        "ring": {
          "$value": "color-mix(in oklch, {primitive.color.blue.600} 24%, transparent)",
          "$description": "Soft ambient focus halo"
        },
        "disabled": {
          "$value": "{primitive.color.slate.200}",
          "$description": "Disabled border"
        }
      },
      "interactive": {
        "primary": {
          "default": {
            "$value": "{primitive.color.blue.600}",
            "$description": "Primary button fill"
          },
          "hover": { "$value": "{primitive.color.blue.700}" },
          "active": { "$value": "{primitive.color.blue.800}" },
          "text": { "$value": "{primitive.color.white}" }
        },
        "secondary": {
          "default": { "$value": "{primitive.color.white}" },
          "hover": { "$value": "{primitive.color.slate.50}" },
          "active": { "$value": "{primitive.color.slate.100}" },
          "text": { "$value": "{primitive.color.slate.800}" },
          "border": { "$value": "{primitive.color.slate.300}" }
        },
        "ghost": {
          "hover": { "$value": "{primitive.color.slate.100}" },
          "text": { "$value": "{primitive.color.slate.700}" }
        },
        "danger": {
          "default": { "$value": "{primitive.color.rose.600}" },
          "hover": { "$value": "{primitive.color.rose.700}" },
          "active": { "$value": "{primitive.color.rose.800}" },
          "text": { "$value": "{primitive.color.white}" }
        }
      },
      "feedback": {
        "success": {
          "surface": { "$value": "{primitive.color.emerald.50}" },
          "border": { "$value": "{primitive.color.emerald.200}" },
          "text": { "$value": "{primitive.color.emerald.800}" }
        },
        "warning": {
          "surface": { "$value": "{primitive.color.amber.50}" },
          "border": { "$value": "{primitive.color.amber.200}" },
          "text": { "$value": "{primitive.color.amber.800}" }
        },
        "danger": {
          "surface": { "$value": "{primitive.color.rose.50}" },
          "border": { "$value": "{primitive.color.rose.200}" },
          "text": { "$value": "{primitive.color.rose.800}" }
        },
        "info": {
          "surface": { "$value": "{primitive.color.blue.50}" },
          "border": { "$value": "{primitive.color.blue.200}" },
          "text": { "$value": "{primitive.color.blue.800}" }
        }
      }
    }
  }
}
