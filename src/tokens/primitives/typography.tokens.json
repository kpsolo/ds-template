{
  "primitive": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
        "$description": "Standard system sans-serif stack"
      },
      "serif": {
        "$value": "Georgia, Cambria, 'Times New Roman', Times, serif",
        "$description": "Standard serif stack"
      },
      "mono": {
        "$value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace",
        "$description": "Standard monospace stack"
      }
    },
    "fontWeight": {
      "$type": "fontWeight",
      "regular": { "$value": "400", "$description": "Regular weight" },
      "medium": { "$value": "500", "$description": "Medium weight" },
      "semibold": { "$value": "600", "$description": "Semibold weight" },
      "bold": { "$value": "700", "$description": "Bold weight" }
    },
    "fontSize": {
      "$type": "dimension",
      "xs": { "$value": "0.75rem", "$description": "12px" },
      "sm": { "$value": "0.875rem", "$description": "14px" },
      "base": { "$value": "1rem", "$description": "16px" },
      "lg": { "$value": "1.125rem", "$description": "18px" },
      "xl": { "$value": "1.25rem", "$description": "20px" },
      "2xl": { "$value": "1.5rem", "$description": "24px" },
      "3xl": { "$value": "1.875rem", "$description": "30px" },
      "4xl": { "$value": "2.25rem", "$description": "36px" },
      "5xl": { "$value": "3rem", "$description": "48px" }
    },
    "lineHeight": {
      "$type": "number",
      "none": { "$value": 1, "$description": "Tight line height 1" },
      "tight": { "$value": 1.25, "$description": "Line height 1.25" },
      "snug": { "$value": 1.375, "$description": "Line height 1.375" },
      "normal": { "$value": 1.5, "$description": "Line height 1.5" },
      "relaxed": { "$value": 1.625, "$description": "Line height 1.625" },
      "loose": { "$value": 2, "$description": "Line height 2" }
    },
    "letterSpacing": {
      "$type": "dimension",
      "tighter": { "$value": "-0.05em" },
      "tight": { "$value": "-0.025em" },
      "normal": { "$value": "0em" },
      "wide": { "$value": "0.025em" },
      "wider": { "$value": "0.05em" }
    }
  }
}
