{
  "primitive": {
    "radius": {
      "$type": "dimension",
      "none": { "$value": "0px", "$description": "No corner radius" },
      "xs": { "$value": "2px" },
      "sm": { "$value": "4px" },
      "md": { "$value": "6px" },
      "lg": { "$value": "8px" },
      "xl": { "$value": "12px" },
      "2xl": { "$value": "16px" },
      "3xl": { "$value": "24px" },
      "full": {
        "$value": "9999px",
        "$description": "Fully rounded pill radius"
      }
    }
  }
}
