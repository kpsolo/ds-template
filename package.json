{
  "name": "@ds-template/tokens",
  "version": "1.0.0",
  "description": "Multi-brand, DTCG-compliant design token system powered by Style Dictionary & TokenOps Studio",
  "type": "module",
  "main": "./dist/ts/index.js",
  "types": "./dist/ts/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ts/index.d.ts",
      "import": "./dist/ts/index.js"
    },
    "./css": "./dist/css/tokens.css",
    "./css/*": "./dist/css/*.css",
    "./scss": "./dist/scss/_index.scss",
    "./scss/*": "./dist/scss/*.scss",
    "./figma/tokens-studio": "./dist/figma/tokens-studio.json",
    "./figma/variables": "./dist/figma/figma-variables.json"
  },
  "files": [
    "dist",
    "src/tokens"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:tokens": "vite src/preview",
    "build": "node scripts/build-tokens.mjs && next build",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:app": "next build",
    "validate": "node scripts/validate-tokens.mjs",
    "start": "next start",
    "lint": "eslint .",
    "clean": "next clean"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.2.1",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "firebase-tools": "^15.0.0",
    "prettier": "^3.5.3",
    "style-dictionary": "^5.6.1",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^6.2.0"
  }
}
